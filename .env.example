# Copy to .env and fill in. Never commit .env.
#
# Only EXPO_PUBLIC_* values go in the app, and they are visible to anyone who has the app.
# The Supabase service role key and the Razorpay key secret must NEVER go in this file;
# they live in Supabase secrets (supabase secrets set ...) for Edge Functions only.

# Supabase dashboard -> Project Settings -> API (or Connect)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (starts with sb_publishable_). Not the secret / service_role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
